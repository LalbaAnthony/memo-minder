# ----------------- DOCKER -----------------

COMPOSE_PROFILES=dev
FRONT_HOST_PORT=5173

# ----------------- FRONTEND -----------------

VITE_FRONT_URL='http://localhost:5173'
VITE_BACK_API_URL='/api'

# ----------------- BACKEND -----------------

BACK_APP_NAME='Memo Minder'
BACK_BYPASS_AUTH=false # Dev only: skips JWT verification. Always `false` in the prod image, whatever the value here
BACK_TOKEN_SECRET_KEY='change-me' # Generate with: openssl rand -hex 64
BACK_TOKEN_EXPIRES_IN=14d
BACK_EMAIL_FROM=''
BACK_EMAIL_USER=''
BACK_EMAIL_PASSWORD=''

# ----------------- DATABASE -----------------

DATABASE_HOST_PORT=3306 # Dev only: host port of db-dev, bound to 127.0.0.1 for local SQL clients (keep the key in prod to avoid Compose warnings)
BACK_DATABASE_NAME='memo-minder'
BACK_DATABASE_USERNAME='mmuser'
BACK_DATABASE_PASSWORD='change-me'
DATABASE_ROOT_PASSWORD='change-me'
