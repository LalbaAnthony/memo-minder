# syntax=docker/dockerfile:1

# ---- build: compile and minify the SPA (devDependencies only live in this stage) ----
FROM node:24-alpine3.24 AS build

WORKDIR /app

COPY package.json package-lock.json ./
RUN --mount=type=cache,target=/root/.npm npm ci

COPY . .

# VITE_* values are inlined into the bundle at build time. Declared after npm ci so changing them only invalidates the build step
ARG VITE_FRONT_URL
ARG VITE_BACK_API_URL

RUN npm run build

# ---- runtime: static files served by an unprivileged nginx, which also proxies /api to the backend ----
FROM nginxinc/nginx-unprivileged:1.30-alpine3.24 AS runtime

COPY nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=build /app/dist /usr/share/nginx/html

EXPOSE 8080

HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
    CMD ["wget", "-q", "-O", "/dev/null", "http://127.0.0.1:8080/healthz"]
